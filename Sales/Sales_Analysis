"""## LOGISTIC REGRESSION: Are plumbing services more profitable than other job services?**

"""

from sklearn.linear_model import LogisticRegression
import pandas as pd

#1 create profit and high-profit
df["profit"] = df["revenue"] - df["cost"]
df["high_profit"] = (df["profit"] >= df["profit"].median()).astype(int)


# 2. Create binary plumbing variable
df = df[df["service"] != "N/A"]
df["is_plumbing"] = (df["service"] == "Plumbing Repair").astype(int)


# 3. X and y testing
X = df[["is_plumbing"]]
y = df["high_profit"]


# 4. Train logistic regression
model = LogisticRegression()
model.fit(X, y)


# 5. Make predictions
X_new = pd.DataFrame({"is_plumbing": [0, 1]})  # 0 = non-plumbing, 1 = plumbing
predictions = model.predict(X_new)
probabilities = model.predict_proba(X_new)


print("Predicted class (0 = not high profit, 1 = high profit):", predictions)
print("Predicted probabilities [P(0), P(1)]:", probabilities)

print("Coefficient:", model.coef_)
print("Intercept:", model.intercept_)

"""## **NEURAL NETWORK** Comparing / Contrasting the binary columns vs the income_mean column

"""

import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense, Input

# Re-initialize df and apply necessary preprocessing to ensure 'income_mean' and 'high_profit' exist
df = pd.read_csv('/content/home_repair_sales_noisy.csv')

# fill the missing with N/A
df["promotion"] = df["promotion"].fillna("N/A")
df["gender"] = df["gender"].fillna("N/A")
df["service"] = df["service"].fillna("N/A")
df["region"] = df["region"].fillna("N/A")

# fill missing age with the column min
df["age"] = df["age"].fillna(df["age"].min())

# replace missing income with unknown
df["income"] = df["income"].fillna("Unknown")

# drop sale_id duplicates
df = df.drop_duplicates("sale_id")

# Create income_mean column (from cell WrFEDgNEWOdy)
income_map = {
    "<40k": 20000,
    "40-80k": 60000,
    "80-120k": 100000,
    "120k+": 140000
}
df["income_mean"] = df["income"].map(income_map)
df["income_mean"] = df["income_mean"].fillna(60000).astype(int)

# Create profit and high_profit (from cell KWHtdlhufevt)
df["profit"] = df["revenue"] - df["cost"]
df["high_profit"] = (df["profit"] >= df["profit"].median()).astype(int)

# Features and target
X_mean = df[['income_mean']].values
y = df['high_profit'].astype(int).values

# Train-test split
X_train, X_test, y_train, y_test = train_test_split(
    X_mean, y, test_size=0.2, random_state=42, stratify=y
)

# Scale
scaler = StandardScaler()
X_train = scaler.fit_transform(X_train)
X_test = scaler.transform(X_test)

# Model
model_mean = Sequential([
    Input(shape=(1,)),
    Dense(16, activation='relu'),
    Dense(8, activation='relu'),
    Dense(1, activation='sigmoid')
])

# Compile
model_mean.compile(
    optimizer='adam',
    loss='binary_crossentropy',
    metrics=['accuracy']
)

# Train
model_mean.fit(
    X_train, y_train,
    epochs=30,
    batch_size=32,
    validation_split=0.1,
    verbose=0
)

# Evaluate
loss_mean, acc_mean = model_mean.evaluate(X_test, y_test, verbose=2)

print("\n--- Neural Network (income_mean only) ---")
print(f"Test Accuracy: {acc_mean * 100:.2f}%")

