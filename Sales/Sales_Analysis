df["service"] = df["service"].fillna("N/A")
df["region"] = df["region"].fillna("N/A")

# fill missing age with the column min
df["age"] = df["age"].fillna(df["age"].min())

# replace missing income with unknown
df["income"] = df["income"].fillna("Unknown")

# drop sale_id duplicates
df = df.drop_duplicates("sale_id")

# Create binary income columns (from cell ATXemyHlZDrS)
df["inc_lt_40k"] = (df["income"] == "<40k").astype(int)
df["inc_40_80k"] = (df["income"] == "40-80k").astype(int)
df["inc_80_120k"] = (df["income"] == "80-120k").astype(int)
df["inc_120k_plus"] = (df["income"] == "120k+").astype(int)

# Create profit and high_profit (from cell KWHtdlhufevt)
